# Supabase — safe to expose (protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini — SERVER SIDE ONLY, never use VITE_ prefix
# Set this in Vercel dashboard environment variables
# GEMINI_API_KEY=your-gemini-key-here  ← DO NOT prefix with VITE_
